{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "/blended-teams",
  "redirects": [
    {
      "source": "/blended-teams/",
      "destination": "/blended-teams",
      "basePath": false,
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^/blended-teams/$"
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/experiments/[id]",
      "regex": "^/experiments/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/experiments/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/plays/[id]",
      "regex": "^/plays/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/plays/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/scorecards/[team]/[cycle]",
      "regex": "^/scorecards/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPteam": "nxtPteam",
        "nxtPcycle": "nxtPcycle"
      },
      "namedRegex": "^/scorecards/(?<nxtPteam>[^/]+?)/(?<nxtPcycle>[^/]+?)(?:/)?$"
    },
    {
      "page": "/teams/[id]",
      "regex": "^/teams/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/teams/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/tools/[id]",
      "regex": "^/tools/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/tools/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/experiments",
      "regex": "^/experiments(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/experiments(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/impact",
      "regex": "^/impact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/impact(?:/)?$"
    },
    {
      "page": "/plays",
      "regex": "^/plays(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/plays(?:/)?$"
    },
    {
      "page": "/scorecards",
      "regex": "^/scorecards(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/scorecards(?:/)?$"
    },
    {
      "page": "/teams",
      "regex": "^/teams(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/teams(?:/)?$"
    },
    {
      "page": "/tools",
      "regex": "^/tools(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tools(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}