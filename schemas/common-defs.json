{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/blended-teams/schemas/common-defs.json",
  "title": "Blended Teams Common Definitions",
  "$defs": {
    "risk": {
      "type": "string",
      "enum": ["value", "usability", "feasibility", "viability"]
    },
    "dimension": {
      "type": "string",
      "enum": [
        "shared-tooling",
        "cross-functional-ownership",
        "experiment-velocity",
        "delivery-autonomy",
        "impact-learning"
      ]
    },
    "riskArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dimensionArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dimension"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "teamRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "recordId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "isoDate": {
      "type": "string",
      "format": "date"
    }
  }
}
