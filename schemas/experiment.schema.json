{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/blended-teams/schemas/experiment.schema.json",
  "title": "Experiment Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "hypothesis",
    "owner",
    "team",
    "risks",
    "dimensions",
    "reviewDate",
    "status",
    "changeSummary",
    "linkedTools",
    "linkedPlays",
    "linkedScorecards"
  ],
  "properties": {
    "id": {
      "$ref": "./common-defs.json#/$defs/recordId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "team": {
      "$ref": "./common-defs.json#/$defs/teamRef"
    },
    "risks": {
      "$ref": "./common-defs.json#/$defs/riskArray"
    },
    "dimensions": {
      "$ref": "./common-defs.json#/$defs/dimensionArray"
    },
    "reviewDate": {
      "$ref": "./common-defs.json#/$defs/isoDate"
    },
    "status": {
      "type": "string",
      "enum": ["active", "kept", "dropped", "inconclusive"]
    },
    "changeSummary": {
      "type": "string",
      "minLength": 1
    },
    "linkedTools": {
      "type": "array",
      "items": {
        "$ref": "./common-defs.json#/$defs/recordId"
      },
      "uniqueItems": true
    },
    "linkedPlays": {
      "type": "array",
      "items": {
        "$ref": "./common-defs.json#/$defs/recordId"
      },
      "uniqueItems": true
    },
    "linkedScorecards": {
      "type": "array",
      "items": {
        "$ref": "./common-defs.json#/$defs/recordId"
      },
      "uniqueItems": true
    },
    "example": {
      "type": "boolean",
      "description": "Marks this record as illustrative example content. Example records stay browsable and cross-linked but are excluded from every org-wide aggregate. Do not set it on real content."
    }
  }
}
