{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/blended-teams/schemas/play.schema.json",
  "title": "Borrowed Skill Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "role",
    "adjacentRole",
    "team",
    "risks",
    "dimensions",
    "move",
    "guardrail",
    "prerequisites",
    "linkedTools",
    "outcomeNotes"
  ],
  "properties": {
    "id": {
      "$ref": "./common-defs.json#/$defs/recordId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "adjacentRole": {
      "type": "string",
      "minLength": 1
    },
    "team": {
      "$ref": "./common-defs.json#/$defs/teamRef"
    },
    "risks": {
      "$ref": "./common-defs.json#/$defs/riskArray"
    },
    "dimensions": {
      "$ref": "./common-defs.json#/$defs/dimensionArray"
    },
    "move": {
      "type": "string",
      "minLength": 1
    },
    "guardrail": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "linkedTools": {
      "type": "array",
      "items": {
        "$ref": "./common-defs.json#/$defs/recordId"
      },
      "uniqueItems": true
    },
    "outcomeNotes": {
      "type": "array",
      "items": {
        "$ref": "./common-defs.json#/$defs/recordId"
      },
      "uniqueItems": true
    }
  }
}
