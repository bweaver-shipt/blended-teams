{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/blended-teams/schemas/scorecard.schema.json",
  "title": "Scorecard Cycle Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "team",
    "cycle",
    "period",
    "risks",
    "dimensions",
    "scores",
    "notes",
    "activeExperiments",
    "observedMovement"
  ],
  "properties": {
    "id": {
      "$ref": "./common-defs.json#/$defs/recordId"
    },
    "team": {
      "$ref": "./common-defs.json#/$defs/teamRef"
    },
    "cycle": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "$ref": "./common-defs.json#/$defs/isoDate"
        },
        "end": {
          "$ref": "./common-defs.json#/$defs/isoDate"
        }
      }
    },
    "risks": {
      "$ref": "./common-defs.json#/$defs/riskArray"
    },
    "dimensions": {
      "$ref": "./common-defs.json#/$defs/dimensionArray"
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shared-tooling",
        "cross-functional-ownership",
        "experiment-velocity",
        "delivery-autonomy",
        "impact-learning"
      ],
      "properties": {
        "shared-tooling": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "cross-functional-ownership": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "experiment-velocity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "delivery-autonomy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "impact-learning": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "activeExperiments": {
      "type": "array",
      "items": {
        "$ref": "./common-defs.json#/$defs/recordId"
      },
      "uniqueItems": true
    },
    "observedMovement": {
      "type": "string",
      "minLength": 1
    },
    "example": {
      "type": "boolean",
      "description": "Marks this record as illustrative example content. Example records stay browsable and cross-linked but are excluded from every org-wide aggregate. Do not set it on real content."
    }
  }
}
